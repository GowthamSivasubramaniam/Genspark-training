    FROM \"serviceRecords\" AS s
    WHERE NOT (s.\"IsDeleted\")
    LIMIT @__p_1 OFFSET @__p_0
) AS s0
INNER JOIN \"Customers\" AS c ON s0.\"CustomerID\" = c.\"CustomerID\"
INNER JOIN \"Mechanics\" AS m ON s0.\"MechanicId\" = m.\"MechanicId\"
INNER JOIN \"Services\" AS s1 ON s0.\"ServiceID\" = s1.\"ServiceID\"
