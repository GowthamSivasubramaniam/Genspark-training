) AS s3 ON s0.\"ServiceID\" = s3.\"ServicesServiceID\"
ORDER BY b0.\"BillID\", s.\"ServiceRecordID\", s0.\"ServiceID\", v.\"VehicleID\", c.\"CustomerID\", m.\"MechanicId\", b1.\"Id\", s3.\"ServiceCategoriesCategoryID\", s3.\"ServicesServiceID\""
