""SELECT b.\"BookingID\", b.\"BookedAt\", b.\"CustomerID\", b.\"DeliveryTime\", b.\"Imageurl\", b.\"IsDeleted\", b.\"Slot\", b.\"Status\", c.\"CustomerID\", c.\"Email\", c.\"Name\", c.\"Phone\", c.\"Status\"
FROM \"Bookings\" AS b
INNER JOIN \"Customers\" AS c ON b.\"CustomerID\" = c.\"CustomerID\"
ORDER BY CASE
    WHEN b.\"Status\" = 'Booked' THEN 0
    WHEN b.\"Status\" = 'Reviewed' THEN 1
