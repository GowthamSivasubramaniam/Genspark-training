    INNER JOIN \"ServiceCategories\" AS s3 ON s2.\"ServiceCategoriesCategoryID\" = s3.\"CategoryID\"
) AS s4 ON s0.\"ServiceID\" = s4.\"ServicesServiceID\"
ORDER BY s1.\"BillID\", s1.\"ServiceRecordID0\", s1.\"CustomerID0\", s1.\"MechanicId0\", s0.\"ServiceID\", v.\"VehicleID\", b0.\"Id\", s4.\"ServiceCategoriesCategoryID\", s4.\"ServicesServiceID\""
