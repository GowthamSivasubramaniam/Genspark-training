""SELECT s0.\"ServiceRecordID\", s0.\"BookingID\", s0.\"CustomerID\", s0.\"IsDeleted\", s0.\"MechanicId\", s0.\"ServiceID\", s0.\"Status\", c.\"CustomerID\", c.\"Email\", c.\"Name\", c.\"Phone\", c.\"Status\", m.\"MechanicId\", m.\"Email\", m.\"Name\", m.\"Phone\", m.\"Status\", s1.\"ServiceID\", s1.\"Description\", s1.\"IsDeleted\", s1.\"VehicleID\", v.\"VehicleID\", s4.\"ServiceCategoriesCategoryID\", s4.\"ServicesServiceID\", s4.\"CategoryID\", s4.\"Amount\", s4.\"Name\", s4.\"Status\", v.\"IsDeleted\", v.\"VechicleManufacturer\", v.\"VehicleModel\", v.\"VehicleNo\", v.\"VehicleType\"
