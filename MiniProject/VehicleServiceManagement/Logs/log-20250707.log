) AS s4 ON s1.\"ServiceID\" = s4.\"ServicesServiceID\"
ORDER BY s0.\"ServiceRecordID\", c.\"CustomerID\", m.\"MechanicId\", s1.\"ServiceID\", v.\"VehicleID\", s4.\"ServiceCategoriesCategoryID\", s4.\"ServicesServiceID\""
