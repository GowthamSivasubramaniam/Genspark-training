    SELECT b.\"BillID\", b.\"Amount\", b.\"Description\", b.\"ServiceRecordID\", b.\"Status\", s.\"ServiceRecordID\" AS \"ServiceRecordID0\", s.\"BookingID\", s.\"CustomerID\", s.\"IsDeleted\", s.\"MechanicId\", s.\"ServiceID\", s.\"Status\" AS \"Status0\", c.\"CustomerID\" AS \"CustomerID0\", c.\"Email\", c.\"Name\", c.\"Phone\", c.\"Status\" AS \"Status1\", m.\"MechanicId\" AS \"MechanicId0\", m.\"Email\" AS \"Email0\", m.\"Name\" AS \"Name0\", m.\"Phone\" AS \"Phone0\", m.\"Status\" AS \"Status2\"
    FROM \"Bills\" AS b
    INNER JOIN \"serviceRecords\" AS s ON b.\"ServiceRecordID\" = s.\"ServiceRecordID\"
    INNER JOIN \"Customers\" AS c ON s.\"CustomerID\" = c.\"CustomerID\"
    INNER JOIN \"Mechanics\" AS m ON s.\"MechanicId\" = m.\"MechanicId\"
    WHERE c.\"Phone\" LIKE @__search_0_contains OR m.\"Phone\" LIKE @__search_0_contains
    LIMIT @__p_2 OFFSET @__p_1
) AS s1
INNER JOIN \"Services\" AS s0 ON s1.\"ServiceID\" = s0.\"ServiceID\"
INNER JOIN \"Vehicles\" AS v ON s0.\"VehicleID\" = v.\"VehicleID\"
LEFT JOIN \"BillCategoryDetail\" AS b0 ON s1.\"BillID\" = b0.\"BillId\"
LEFT JOIN (
