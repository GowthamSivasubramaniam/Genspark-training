""SELECT s1.\"BillID\", s1.\"Amount\", s1.\"Description\", s1.\"ServiceRecordID\", s1.\"Status\", s1.\"ServiceRecordID0\", s1.\"CustomerID0\", s1.\"MechanicId0\", s0.\"ServiceID\", v.\"VehicleID\", b0.\"Id\", b0.\"Amount\", b0.\"BillId\", b0.\"CategoryName\", s1.\"BookingID\", s1.\"CustomerID\", s1.\"IsDeleted\", s1.\"MechanicId\", s1.\"ServiceID\", s1.\"Status0\", s0.\"Description\", s0.\"IsDeleted\", s0.\"VehicleID\", s4.\"ServiceCategoriesCategoryID\", s4.\"ServicesServiceID\", s4.\"CategoryID\", s4.\"Amount\", s4.\"Name\", s4.\"Status\", v.\"IsDeleted\", v.\"VechicleManufacturer\", v.\"VehicleModel\", v.\"VehicleNo\", v.\"VehicleType\", s1.\"Email\", s1.\"Name\", s1.\"Phone\", s1.\"Status1\", s1.\"Email0\", s1.\"Name0\", s1.\"Phone0\", s1.\"Status2\"
FROM (
    SELECT b.\"BillID\", b.\"Amount\", b.\"Description\", b.\"ServiceRecordID\", b.\"Status\", s.\"ServiceRecordID\" AS \"ServiceRecordID0\", s.\"BookingID\", s.\"CustomerID\", s.\"IsDeleted\", s.\"MechanicId\", s.\"ServiceID\", s.\"Status\" AS \"Status0\", c.\"CustomerID\" AS \"CustomerID0\", c.\"Email\", c.\"Name\", c.\"Phone\", c.\"Status\" AS \"Status1\", m.\"MechanicId\" AS \"MechanicId0\", m.\"Email\" AS \"Email0\", m.\"Name\" AS \"Name0\", m.\"Phone\" AS \"Phone0\", m.\"Status\" AS \"Status2\"
    FROM \"Bills\" AS b
    INNER JOIN \"serviceRecords\" AS s ON b.\"ServiceRecordID\" = s.\"ServiceRecordID\"
